{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kenshi/location-registry.schema.json",
  "title": "Реестр локаций кампании: обнаружение из сейва и отметки зачистки",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "campaign_id", "snapshot_id", "world_ref_id", "game_time", "locations"],
  "properties": {
    "format": {"const": "kenshi-location-registry/3"},
    "campaign_id": {"type": ["string", "null"], "minLength": 1},
    "snapshot_id": {"$ref": "#/$defs/id"},
    "world_ref_id": {"$ref": "#/$defs/id"},
    "game_time": {"type": ["string", "number", "null"]},
    "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "game_time": {"type": "string", "pattern": "^Day [0-9]+ ([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "name_ru", "name_en", "kind", "region", "x", "z", "is_secret", "is_public",
                   "unexplored_name"],
      "dependentRequired": {"discovered": ["discovered_source"], "discovered_source": ["discovered"]},
      "properties": {
        "instance_id": {"$ref": "#/$defs/id"},
        "name_ru": {"type": ["string", "null"]},
        "name_en": {"type": "string"},
        "kind": {"type": "string"},
        "region": {"type": ["string", "null"]},
        "x": {"type": "number"},
        "z": {"type": "number"},
        "is_secret": {"type": ["boolean", "null"]},
        "is_public": {"type": ["boolean", "null"]},
        "unexplored_name": {"type": ["string", "null"]},
        "template_faction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sid", "name_en"],
          "properties": {
            "sid": {"$ref": "#/$defs/id"},
            "name_en": {"type": "string", "minLength": 1},
            "name_ru": {"type": ["string", "null"]}
          }
        },
        "discovered": {"type": "boolean"},
        "discovered_source": {"const": "quick.save:Town state.discovered"},
        "cleared": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidence"],
          "properties": {
            "evidence": {"type": "string", "pattern": "\\S"},
            "game_time": {"$ref": "#/$defs/game_time"}
          }
        }
      }
    }
  }
}
