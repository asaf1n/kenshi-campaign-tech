{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kenshi/manifest.schema.json",
  "title": "Kenshi publication manifest (draft)",
  "description": "Предлагаемый контракт публикации; не формат входного сейва и не подмена kenshi-session/10.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "generated_at",
    "snapshot_id",
    "source_kind",
    "source_format",
    "source_sha256",
    "artifacts",
    "validation"
  ],
  "properties": {
    "format": {
      "const": "kenshi-publication/2"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_snapshot_id": {"type": ["string", "null"]},
    "campaign_id": {"type": ["string", "null"]},
    "game_time": {"type": ["string", "number", "null"]},
    "world_ref_id": {"type": ["string", "null"]},
    "source_format": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "changes",
        "brief"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/relativePath"
        },
        "current_index": {
          "$ref": "#/$defs/relativePath",
          "deprecated": true,
          "description": "Устарел: каталог current/ не публикуется; ключ допускается только в манифестах прежних выпусков."
        },
        "changes": {
          "$ref": "#/$defs/relativePath"
        },
        "brief": {
          "$ref": "#/$defs/relativePath"
        },
        "squad": {
          "$ref": "#/$defs/relativePath",
          "deprecated": true,
          "description": "Устарел: монолитный squad.md снят с публикации; полный состав отряда доступен в tables/squad.csv."
        },
        "timeline": {
          "$ref": "#/$defs/relativePath"
        },
        "locations": {
          "$ref": "#/$defs/relativePath"
        },
        "world_reference": {
          "$ref": "#/$defs/relativePath"
        },
        "location_registry": {
          "const": "location_registry.json"
        },
        "unique_entities_registry": {
          "$ref": "#/$defs/relativePath"
        },
        "screenshots": {
          "$ref": "#/$defs/relativePath"
        },
        "changes_md": {
          "$ref": "#/$defs/relativePath"
        },
        "screenshot_index_md": {
          "$ref": "#/$defs/relativePath"
        },
        "screenshot_annotations": {
          "$ref": "#/$defs/relativePath"
        },
        "screenshot_feed": {
          "$ref": "#/$defs/relativePath"
        },
        "tables": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "source_kind": {
      "enum": [
        "save",
        "export"
      ]
    },
    "reload": {
      "description": "Перезагрузка: игровое время снимка меньше времени родителя; diff с родителем не строится.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from_snapshot", "from_game_time"],
      "properties": {
        "from_snapshot": {"type": "string", "minLength": 1},
        "from_game_time": {"type": ["string", "null"], "pattern": "^Day [0-9]+ [0-9]{2}:[0-9]{2}$"}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\./)[A-Za-z0-9_.\\-/]+$"
    }
  }
}
