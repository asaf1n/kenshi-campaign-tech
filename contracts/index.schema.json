{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kenshi/index.schema.json",
  "title": "Kenshi snapshots index",
  "description": "Контракт файлового реестра снимков kenshi-index/2: одна линия на кампанию, родитель — голова кампании.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "updated_at",
    "campaigns",
    "snapshots"
  ],
  "properties": {
    "format": {
      "const": "kenshi-index/2"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "campaigns": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "head_snapshot_id"
        ],
        "properties": {
          "head_snapshot_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "snapshot_id",
          "parent_snapshot_id",
          "campaign_id",
          "game_time",
          "world_ref_id",
          "source_kind",
          "source_sha256",
          "registered_at"
        ],
        "properties": {
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_snapshot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "campaign_id": {
            "type": "string",
            "minLength": 1
          },
          "game_time": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "day": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "time": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "world_ref_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_kind": {
            "enum": [
              "save",
              "export"
            ]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "registered_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
