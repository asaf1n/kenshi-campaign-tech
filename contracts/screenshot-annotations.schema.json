{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kenshi/screenshot-annotations.schema.json",
  "title": "Kenshi screenshot technical extraction record (kenshi-screenshot-annotation/1)",
  "description": "Технический экстракт кадра для контекстного поиска LLM-компаньоном. Содержит только файловые метаданные, перцептивное хеширование и распознанный текст интерфейса (OCR).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "sha256",
    "filename",
    "order",
    "modified_at",
    "meta",
    "ocr",
    "provenance"
  ],
  "properties": {
    "format": {
      "const": "kenshi-screenshot-annotation/1"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "filename": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.(jpg|jpeg|png)$"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "modified_at": {
      "type": "string",
      "format": "date-time"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dhash",
        "scene_group_id",
        "is_exact_duplicate"
      ],
      "properties": {
        "dhash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "scene_group_id": {
          "type": "string",
          "minLength": 1
        },
        "is_exact_duplicate": {
          "type": "boolean"
        },
        "duplicate_of": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ocr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "dialogues",
        "notifications",
        "items_or_tasks"
      ],
      "properties": {
        "game_day": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "game_time": {
          "type": ["string", "null"],
          "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
        },
        "location": {
          "type": ["string", "null"]
        },
        "characters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dialogues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "speaker": { "type": ["string", "null"] },
              "text": { "type": "string", "minLength": 1 },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        },
        "notifications": {
          "type": "array",
          "items": { "type": "string" }
        },
        "items_or_tasks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "extracted_at"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "gemini-3.8-flash",
            "ocr",
            "metadata",
            "cache"
          ]
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0.0,
          "maximum": 1.0
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
