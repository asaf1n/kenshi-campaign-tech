{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kenshi/location-progress.schema.json",
  "title": "Подтверждённые ручные отметки локаций",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "campaign_id", "world_ref_id", "locations"],
  "properties": {
    "format": {"const": "kenshi-location-progress/2"},
    "campaign_id": {"type": "string", "minLength": 1},
    "world_ref_id": {"type": "string", "minLength": 1},
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "status", "evidence"],
        "properties": {
          "instance_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["visited", "explored"]},
          "evidence": {"type": "string", "pattern": "\\S"},
          "game_time": {"type": "string", "pattern": "^Day [0-9]+ ([01][0-9]|2[0-3]):[0-5][0-9]$"}
        }
      }
    }
  }
}
