{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kenshi/timeline-event.schema.json",
  "title": "Kenshi timeline event (draft)",
  "description": "Один JSON-объект на строку в events.jsonl. Схема не определяет сам порядок игровых событий.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "event_id", "session_id", "recorded_at", "kind", "status", "summary", "evidence"],
  "properties": {
    "format": {"const": "kenshi-event/1"},
    "event_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "corrects_event_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "game_day": {"type": ["integer", "null"], "minimum": 0},
    "game_time": {"type": "string", "pattern": "^Day [0-9]+ [0-9]{2}:[0-9]{2}$"},
    "kind": {"type": "string", "minLength": 1},
    "status": {"enum": ["observed", "confirmed", "inferred"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"enum": ["snapshot", "diff", "screenshot", "user_note", "other"]},
          "ref": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "correction"}}, "required": ["kind"]},
      "then": {"required": ["corrects_event_id"]}
    }
  ]
}
