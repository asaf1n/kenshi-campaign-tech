# Игровые сохранения и исходные скриншоты: только локально
raw/*
!raw/.gitkeep
*.save
*.quick
*.autosave
*.backup

# Секреты и настройки ПК
.env
.env.*
!.env.example
*.key
*.pem

# Временные результаты
.cache/
cache/
scratch/
.tmp/
.cache-*/
__pycache__/
.pytest_cache/
*.py[cod]
.venv/
dist/

# Локальные снимки регистрирует pipeline; публикация выполняется отдельно
data/index.json
data/snapshots/*/
data/diffs/*
!data/diffs/.gitkeep
data/world/*
!data/world/.gitkeep
data/locations/*
!data/locations/.gitkeep
tests/.evidence/

# Этапные локальные сессии AI-Orchestrated-Workflow исключаются
# ТОЛЬКО точными путями через .git/info/exclude при запуске конкретного плана.
